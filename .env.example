NEXT_PUBLIC_WISE_URL=https://your-wise-payment-url.example
NEXT_PUBLIC_PAYPAL_URL=https://www.paypal.com/paypalme/your-account
NEXT_PUBLIC_ALIPAY_QR_URL=/images/alipay-qr.png
# Admin Panel Credentials
ADMIN_EMAIL=admin@ghkpep.com
ADMIN_PASSWORD=your-admin-password-here
SESSION_SECRET=change-this-to-a-random-secret-string

# Email Service (Fasthosts SMTP)
SMTP_HOST=smtp.livemail.co.uk
SMTP_PORT=587
SMTP_USER=mailbox@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_EMAIL=mailbox@yourdomain.com
SMTP_FROM_NAME=Your Name

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=orders@ghkpep.com

# WhatsApp (for order processing)
NEXT_PUBLIC_WHATSAPP_NUMBER=447123456789
NEXT_PUBLIC_TELEGRAM_USERNAME=your_username
NEXT_PUBLIC_CONTACT_PHONE=441234567890
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Social publishing (server-only; add only official OAuth credentials)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
CRON_SECRET=generate-a-long-random-secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=GHKpepMarketing/1.0
X_ACCESS_TOKEN=

# Supabase (required for durable Vercel accounts, orders, and support inbox)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
