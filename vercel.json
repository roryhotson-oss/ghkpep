{
  "crons": [
    {
      "path": "/api/cron/marketing",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "43 6 * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "17 3 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://www.ghkpep.com/:path*",
      "permanent": true
    }
  ]
}