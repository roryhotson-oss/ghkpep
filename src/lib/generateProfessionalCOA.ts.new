import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';
import { Product } from '@/data/products';

/**
 * Produces a batch REFERENCE SUMMARY, not a certificate of analysis.
 *
 * Compliance note: this document must never assert analytical results, release
 * approval, accreditation, or testing performed by or for GHK Peptides. Genuine
 * third-party analytical documents are supplied separately and unaltered. Do not
 * reintroduce a results table, an analysis date, signature blocks, or a quality
 * management system claim without verified evidence for the specific lot.
 */
export async function generateProfessionalCOA(product: Product) {
  const purityReference = product.purity
    ? product.purity.replaceAll('≥', '>=').replaceAll('≤', '<=')
    : 'Not stated';

  const pdfDoc = await PDFDocument.create();
  const page = pdfDoc.addPage([595.28, 841.89]); // A4
  const pageWidth = page.getWidth();
  const pageHeight = page.getHeight();

  const helveticaFont = await pdfDoc.embedFont(StandardFonts.Helvetica);
  const helveticaBold = await pdfDoc.embedFont(StandardFonts.HelveticaBold);

  const navy = rgb(0.18, 0.28, 0.36);
  const darkGray = rgb(0.12, 0.15, 0.18);
  const lightGray = rgb(0.93, 0.94, 0.95);
  const midGray = rgb(0.42, 0.46, 0.5);
  const white = rgb(1, 1, 1);

  let yPos = pageHeight - 50;

  page.drawRectangle({ x: 0, y: yPos - 100, width: pageWidth, height: 120, color: navy });

  page.drawText('GHK PEPTIDES', {
    x: 50,
    y: yPos - 40,
    size: 32,
    font: helveticaBold,
    color: white,
  });

  page.drawText('Batch reference summary', {
    x: 50,
    y: yPos - 70,
    size: 18,
    font: helveticaFont,
    color: white,
  });

  yPos -= 150;

  page.drawRectangle({ x: 50, y: yPos - 90, width: pageWidth - 100, height: 110, color: lightGray });

  page.drawText(`Product: ${product.name}`, {
    x: 70,
    y: yPos - 25,
    size: 14,
    font: helveticaBold,
    color: darkGray,
  });

  page.drawText(`Lot / batch reference: ${product.lot}`, {
    x: 70,
    y: yPos - 48,
    size: 12,
    font: helveticaFont,
    color: darkGray,
  });

  page.drawText(`Catalogue purity reference: ${purityReference}`, {
    x: 70,
    y: yPos - 68,
    size: 12,
    font: helveticaFont,
    color: darkGray,
  });

  page.drawText('Laboratory research and chemistry use only. Not for human or veterinary use.', {
    x: 70,
    y: yPos - 85,
    size: 9,
    font: helveticaFont,
    color: darkGray,
  });

  yPos -= 130;

  page.drawText('WHAT THIS DOCUMENT IS', {
    x: 50,
    y: yPos,
    size: 14,
    font: helveticaBold,
    color: navy,
  });

  yPos -= 24;

  const statements = [
    'This summary reproduces the catalogue and lot reference information held by GHK Peptides',
    'for the listed batch. It records what is on file; it is not a test report.',
    '',
    'It is not a certificate of analysis. It does not report analytical testing carried out by or',
    'for GHK Peptides, and it does not constitute release approval, clinical approval, medical',
    'advice, accreditation, or regulatory clearance.',
    '',
    'Where a supplier has provided third-party analytical documentation for this lot, that',
    'documentation is supplied separately and unaltered. Availability varies by lot and by',
    'supplier. Purity figures shown above are catalogue references supplied to us, not results',
    'measured by GHK Peptides.',
  ];

  statements.forEach((line, index) => {
    if (!line) return;
    page.drawText(line, {
      x: 50,
      y: yPos - index * 15,
      size: 10,
      font: helveticaFont,
      color: darkGray,
    });
  });

  yPos -= statements.length * 15 + 25;

  page.drawRectangle({ x: 50, y: yPos - 46, width: pageWidth - 100, height: 58, color: lightGray });

  page.drawText('IMPORTANT', {
    x: 70,
    y: yPos - 18,
    size: 12,
    font: helveticaBold,
    color: navy,
  });

  page.drawText('Materials are supplied for non-human, in-vitro laboratory research only. They are not', {
    x: 70,
    y: yPos - 33,
    size: 9,
    font: helveticaFont,
    color: darkGray,
  });

  page.drawText('medicines and have not been evaluated by the MHRA, the FDA, or any other regulator.', {
    x: 70,
    y: yPos - 44,
    size: 9,
    font: helveticaFont,
    color: darkGray,
  });

  yPos -= 80;

  page.drawText('Prepared from the catalogue and lot records held at the time of download.', {
    x: 50,
    y: yPos,
    size: 8,
    font: helveticaFont,
    color: midGray,
  });

  page.drawText('GHK Peptides UK | www.ghkpep.com', {
    x: 50,
    y: yPos - 14,
    size: 8,
    font: helveticaFont,
    color: midGray,
  });

  const pdfBytes = await pdfDoc.save();
  return pdfBytes;
}
